; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Godot MultiSeat"
config/description="Local multi-seat and streaming framework for Godot 4: several players share one authoritative world while each keeps an independent display, controller, HUD and private information."
config/features=PackedStringArray("4.7")

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg", "res://addons/multiseat/plugin.cfg")
